# Security headers for every response. /_astro/* is fingerprinted, so it gets
# its own rule at the bottom of this file with a long immutable cache lifetime.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(), display-capture=(), serial=(), hid=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  # HTML is fingerprintless: let the browser revalidate instead of trusting a
  # stale copy across deploys. /_astro/* overrides this with its own rule below.
  Cache-Control: public, max-age=0, must-revalidate
  # 'unsafe-inline' in script-src is load-bearing: Astro inlines every component
  # module as a small <script> tag (the built page ships 0 external scripts), and
  # a static _headers file cannot carry a per-build hash or nonce. Removing it
  # breaks the FAQ animation, the contact form and the theme toggle. style-src
  # stays 'self' — the build emits no <style> block and no style="" attribute.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests

# Content-hashed output: the filename changes on every deploy, so the browser
# never needs to revalidate it. The `!` detaches the `/*` rule's Cache-Control
# first — without it Cloudflare joins both values with a comma and the
# max-age=0 from the rule above wins. Must stay after `/*` for that reason.
# Every other header (CSP, HSTS, …) still applies: a request inherits the
# headers of every rule whose pattern matches.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
